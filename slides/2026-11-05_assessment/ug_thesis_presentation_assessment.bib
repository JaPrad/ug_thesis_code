@article{paul_moser,
	title = {Unemployment impairs mental health: Meta-analyses},
	volume = {74},
	issn = {0001-8791},
	url = {https://www.sciencedirect.com/science/article/pii/S0001879109000037},
	doi = {10.1016/j.jvb.2009.01.001},
	shorttitle = {Unemployment impairs mental health},
	abstract = {The effect of unemployment on mental health was examined with meta-analytic methods across 237 cross-sectional and 87 longitudinal studies. The average overall effect size was d=0.51 with unemployed persons showing more distress than employed persons. A significant difference was found for several indicator variables of mental health (mixed symptoms of distress, depression, anxiety, psychosomatic symptoms, subjective well-being, and self esteem). The average number of persons with psychological problems among the unemployed was 34\%, compared to 16\% among employed individuals. Moderator analyses demonstrated that men and people with blue-collar-jobs were more distressed by unemployment than women and people with white-collar jobs. Linear and curvilinear moderating effects of the duration of unemployment were also identified. Furthermore, the negative effect of unemployment on mental health was stronger in countries with a weak level of economic development, unequal income distributions, or weak unemployment protection systems compared to other countries. Meta-analyses of longitudinal studies and natural experiments endorsed the assumption that unemployment is not only correlated to distress but also causes it. Seemingly inconsistent longitudinal results of older meta-analyses can be explained by retest artifacts. We also identified mental-health related selection effects during job loss and job search, but they are weak. With an effect size of d=−.35 intervention programs for unemployed people were found to be moderately effective in ameliorating unemployment-related distress among continuously unemployed persons.},
	pages = {264--282},
	number = {3},
	journaltitle = {Journal of Vocational Behavior},
	shortjournal = {Journal of Vocational Behavior},
	author = {Paul, Karsten I. and Moser, Klaus},
	urldate = {2026-11-09},
	date = {2009-06-01},
	keywords = {Distress, Job loss, Mental health, Meta-analysis, Reemployment, Selection effect, Social causation, Unemployment},
	file = {ScienceDirect Snapshot:C\:\\Users\\japrad_local\\Zotero\\storage\\4JPQQJFC\\S0001879109000037.html:text/html},
}

@article{berg_ours,
	title = {Unemployment Dynamics and Duration Dependence},
	volume = {14},
	url = {https://www.journals.uchicago.edu/doi/10.1086/209805},
	doi = {https://doi.org/10.1086/209805},
	shorttitle = {Unemployment Dynamics and Duration Dependence {\textbar} Journal of Labor Economics},
	abstract = {A major issue in the analysis of unemployment durations concerns distinguishing genuine
duration dependence of the exit rate out of unemployment from unobserved heterogeneity.
We present a method for the nonparametric estimation of both phenomena, designed to
be applicable to time-series data on aggregate outflows from different duration classes.
The model explicitly takes into account that individual exit rates are affected by
the business cycle and by seasonal effects. The method is applied to U.S. data. We
find diverging duration effects among black and white individuals. However, except
for white males, duration dependence is dominated by unobserved heterogeneity.},
	number = {1},
	journaltitle = {Journal of Labor Economics},
	author = {van dem Berg, Gerard J. and van Ours, Jan C.},
	urldate = {2026-11-10},
	date = {1996},
